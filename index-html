function StockPage({ C, stockMap, products, purchases, sales }) {																							
  return (																							
    <Card>																							
      <h3 style={{ margin: "0 0 16px", color: C.primary }}>গুদাম স্টক ও বর্তমান বিবরণী</h3>																							
      <Table 																							
        headers={["পণ্যের নাম", "মোট ক্রয় (পিস)", "মোট বিক্রয় (পিস)", "বর্তমান স্টক", "অবস্থা"]}																							
        rows={products.map(name => {																							
          const pQty = purchases.filter(p => p.product === name).reduce((s,r)=>s+r.qty, 0);																							
          const sQty = sales.filter(s => s.product === name).reduce((s,r)=>s+r.qty, 0);																							
          const st = stockMap[name] || 0;																							
          let status = <span style={{ color: C.success, fontWeight: 600 }}>✅ পর্যাপ্ত</span>;																							
          if(st <= 0) status = <span style={{ color: C.danger, fontWeight: 600 }}>❌ স্টকআউট</span>;																							
          else if(st <= 5) status = <span style={{ color: C.warn, fontWeight: 600 }}>⚠️ রি-অর্ডার লেভেল</span>;																							
                                                                                                                
          return [name, fmtNum(pQty), fmtNum(sQty), <strong key={name} style={{ color: st < 0 ? C.danger : C.text }}>{fmtNum(st)} পিস</strong>, status];																							
        })}																							
      />																							
    </Card>																							
  );																							
}																							
																							
