//  SALES PAGE SUB-COMPONENT
// ══════════════════════════════════════════════════════																							
function SalesPage({ C, sales, setSales, customers, products, showToast, stockMap, purchases }) {																							
  const [date, setDate] = useState(today());																							
  const [customer, setCustomer] = useState("CASH CASTOMAR");																							
  const [product, setProduct] = useState("");																							
  const [qty, setQty] = useState("");																							
  const [price, setPrice] = useState("");																							
  const [invoiceNo, setInvoiceNo] = useState("");																							
																							
  const total = Number(qty || 0) * Number(price || 0);																							
  const currentStock = stockMap[product] || 0;																							
																							
  const handleAdd = () => {																							
    if (!customer || !product || !qty || !price) {																							
      showToast("সবগুলো ঘর সঠিকভাবে পূরণ করুন", "warn");																							
      return;																							
    }																							
                                                                                                
    const matchingPurchases = purchases.filter(p => p.product === product);																							
    let avgPurchasePrice = 0;																							
    if (matchingPurchases.length > 0) {																							
      const totalPVal = matchingPurchases.reduce((s, r) => s + r.total, 0);																							
      const totalPQty = matchingPurchases.reduce((s, r) => s + r.qty, 0);																							
      avgPurchasePrice = totalPQty > 0 ? (totalPVal / totalPQty) : 0;																							
    }																							
    const profit = total - (Number(qty) * avgPurchasePrice);																							
																							
    const newTx = { date, customer, product, qty: Number(qty), price: Number(price), total, profit, invoiceNo, id: Date.now() };																							
    setSales([newTx, ...sales]);																							
    setProduct(""); setQty(""); setPrice(""); setInvoiceNo("");																							
    showToast("বিক্রয় রেকর্ড সফলভাবে সেভ হয়েছে");																							
  };																							
																							
  const handleDelete = (id) => {																							
    if(confirm("আপনি কি এই বিক্রয় রেকর্ডটি ডিলিট করতে চান?")) {																							
      setSales(sales.filter(s => s.id !== id));																							
      showToast("রেকর্ড ডিলিট করা হয়েছে", "warn");																							
    }																							
  };																							
																							
  return (																							
    <div style={{ display: "grid", gridTemplateColumns: "320px 1fr", gap: 20 }}>																							
      <Card>																							
        <h3 style={{ margin: "0 0 16px", color: C.primary }}>নতুন বিক্রয় ক্যাশ মেমো</h3>																							
        <Input label="তারিখ" type="date" value={date} onChange={setDate} required />																							
        <Input label="মেমো / ইনভয়েস নং" value={invoiceNo} onChange={setInvoiceNo} placeholder="ঐচ্ছিক" />																							
        <Select label="কাস্টমার" value={customer} onChange={setCustomer} options={customers} required />																							
        <Select label="পণ্য" value={product} onChange={setProduct} options={products} required />																							
        {product && (																							
          <div style={{ fontSize: 12, color: currentStock <= 5 ? C.danger : C.success, fontWeight: 600, marginBottom: 8 }}>																							
            বর্তমান স্টক: {fmtNum(currentStock)} পিস																							
          </div>																							
        )}																							
        <Input label="বিক্রয় পরিমাণ (পিস)" type="number" value={qty} onChange={setQty} required />																							
        <Input label="বিক্রয়মূল্য (প্রতি পিস)" type="number" value={price} onChange={setPrice} required />																							
        <div style={{ background: "#f8fafc", padding: 12, borderRadius: 8, marginBottom: 16, border: `1px dashed ${C.border}` }}>																							
          <div style={{ fontSize: 12, color: C.muted }}>মোট বিল:</div>																							
          <div style={{ fontSize: 20, fontWeight: 700, color: C.success }}>৳{fmtNum(total)}</div>																							
        </div>																							
        <Btn onClick={handleAdd} color={C.primary} style={{ width: "100%", justifyContent: "center" }}><Icon name="sales" /> মেমো প্রিন্ট ও সেভ</Btn>																							
      </Card>																							
                                                                                                        
      <Card>																							
        <h3 style={{ margin: "0 0 16px", color: C.primary }}>বিক্রয় খতিয়ান (সর্বশেষ ১০০টি)</h3>																							
        <Table 																							
          headers={["তারিখ", "মেমো নং", "কাস্টমার", "মালামাল", "পরিমাণ", "বিক্রয় দর", "মোট বিল", "অ্যাকশন"]}																							
          rows={sales.slice(0, 100).map(s => [																							
            fmtDate(s.date), s.invoiceNo || "N/A", s.customer, s.product, `${fmtNum(s.qty)} পিস`, `৳${fmtNum(s.price)}`, `৳${fmtNum(s.total)}`,																							
            <Btn key={s.id} onClick={() => handleDelete(s.id)} color={C.danger} small><Icon name="delete" /></Btn>																							
          ])}																							
        />																							
      </Card>																							
    </div>																							
  );																							
}																							
																							
