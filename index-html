//  BILL SEARCH PAGE SUB-COMPONENT
// ══════════════════════════════════════════════════════																							
function BillSearchPage({ sales, purchases }) {																							
  const [q, setQ] = useState("");																							
																							
  const filteredSales = useMemo(() => {																							
    if (!q) return [];																							
    return sales.filter(s => 																							
      (s.invoiceNo && s.invoiceNo.toLowerCase().includes(q.toLowerCase())) ||																							
      s.customer.toLowerCase().includes(q.toLowerCase()) ||																							
      s.product.toLowerCase().includes(q.toLowerCase())																							
    );																							
  }, [q, sales]);																							
																							
  const filteredPurchases = useMemo(() => {																							
    if (!q) return [];																							
    return purchases.filter(p => 																							
      (p.billNo && p.billNo.toLowerCase().includes(q.toLowerCase())) ||																							
      p.supplier.toLowerCase().includes(q.toLowerCase()) ||																							
      p.product.toLowerCase().includes(q.toLowerCase())																							
    );																							
  }, [q, purchases]);																							
																							
  return (																							
    <Card>																							
      <Input placeholder="মেমো নম্বর, কাস্টমার, সাপ্লায়ার অথবা পণ্যের নাম দিয়ে খুঁজুন..." value={q} onChange={setQ} />																							
      {q && (																							
        <div style={{ marginTop: 16 }}>																							
          <h3 style={{ color: "#1a5276", fontSize: 16, marginBottom: 8 }}>🔎 মেলানো বিক্রয় বিলসমূহ ({filteredSales.length})</h3>																							
          <Table headers={["তারিখ", "মেমো", "কাস্টমার", "পণ্য", "পরিমাণ", "টাকা"]} rows={filteredSales.map(s => [fmtDate(s.date), s.invoiceNo || "-", s.customer, s.product, s.qty, `৳${fmtNum(s.total)}`])} />																							
                                                                                                                
          <h3 style={{ color: "#1a5276", marginTop: 24, fontSize: 16, marginBottom: 8 }}>🔎 মেলানো ক্রয় বিলসমূহ ({filteredPurchases.length})</h3>																							
          <Table headers={["তারিখ", "বিল নং", "সাপ্লায়ার", "পণ্য", "পরিমাণ", "টাকা"]} rows={filteredPurchases.map(p => [fmtDate(p.date), p.billNo || "-", p.supplier, p.product, p.qty, `৳${fmtNum(p.total)}`])} />																							
        </div>																							
      )}																							
    </Card>																							
  );																							
}																							
																							
