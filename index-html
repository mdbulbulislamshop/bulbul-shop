//  MASTER LIST PAGE SUB-COMPONENT
// ══════════════════════════════════════════════════════																							
function MasterPage({ C, customers, setCustomers, suppliers, setSuppliers, products, setProducts, showToast }) {																							
  const [newCust, setNewCust] = useState("");																							
  const [newSupp, setNewSupp] = useState("");																							
  const [newProd, setNewProd] = useState("");																							
																							
  const addCustomer = () => {
    if (!newCust.trim()) return;
    if (customers.includes(newCust.trim())) {
      showToast("এই কাস্টমার ইতিমধ্যে যুক্ত আছে", "warn");
      return;
    }
    setCustomers([...customers, newCust.trim()]);
    setNewCust("");
    showToast("নতুন কাস্টমার সফলভাবে যোগ হয়েছে");
  };

  const addSupplier = () => {
    if (!newSupp.trim()) return;
    if (suppliers.includes(newSupp.trim())) {
      showToast("এই সাপ্লায়ার ইতিমধ্যে যুক্ত আছে", "warn");
      return;
    }
    setSuppliers([...suppliers, newSupp.trim()]);
    setNewSupp("");
    showToast("নতুন সাপ্লায়ার সফলভাবে যোগ হয়েছে");
  };

  const addProduct = () => {
    if (!newProd.trim()) return;
    if (products.includes(newProd.trim())) {
      showToast("এই পণ্যটি ইতিমধ্যে যুক্ত আছে", "warn");
      return;
    }
    setProducts([...products, newProd.trim()]);
    setNewProd("");
    showToast("নতুন পণ্য সফলভাবে যোগ হয়েছে");
  };

  return (
    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 20 }}>
      {/* কাস্টমার ম্যানেজমেন্ট */}
      <Card>
        <h3 style={{ margin: "0 0 16px", color: C.primary }}>👥 কাস্টমার ডাটাবেজ</h3>
        <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
          <Input placeholder="নতুন কাস্টমার নাম..." value={newCust} onChange={setNewCust} />
          <Btn onClick={addCustomer} color={C.success} style={{ whiteSpace: "nowrap", height: "40px", marginTop: "24px" }}><Icon name="add" /> যোগ</Btn>
        </div>
        <div style={{ maxHeight: 300, overflowY: "auto", border: `1px solid ${C.border}`, borderRadius: 8, padding: 8 }}>
          {customers.map((c, idx) => (
            <div key={idx} style={{ padding: "8px 12px", borderBottom: idx !== customers.length - 1 ? `1px solid ${C.border}` : "none", color: C.text, fontSize: 14 }}>
              {c}
            </div>
          ))}
        </div>
      </Card>

      {/* সাপ্লায়ার ম্যানেজমেন্ট */}
      <Card>
        <h3 style={{ margin: "0 0 16px", color: C.primary }}>🏢 সাপ্লায়ার ডাটাবেজ</h3>
        <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
          <Input placeholder="নতুন সাপ্লায়ার নাম..." value={newSupp} onChange={setNewSupp} />
          <Btn onClick={addSupplier} color={C.primary} style={{ whiteSpace: "nowrap", height: "40px", marginTop: "24px" }}><Icon name="add" /> যোগ</Btn>
        </div>
        <div style={{ maxHeight: 300, overflowY: "auto", border: `1px solid ${C.border}`, borderRadius: 8, padding: 8 }}>
          {suppliers.map((s, idx) => (
            <div key={idx} style={{ padding: "8px 12px", borderBottom: idx !== suppliers.length - 1 ? `1px solid ${C.border}` : "none", color: C.text, fontSize: 14 }}>
              {s}
            </div>
          ))}
        </div>
      </Card>

      {/* প্রোডাক্ট ম্যানেজমেন্ট */}
      <Card>
        <h3 style={{ margin: "0 0 16px", color: C.primary }}>📦 প্রোডাক্ট ক্যাটালগ</h3>
        <div style={{ display: "flex", gap: 8, marginBottom: 16 }}>
          <Input placeholder="নতুন পণ্যের নাম..." value={newProd} onChange={setNewProd} />
          <Btn onClick={addProduct} color={C.success} style={{ whiteSpace: "nowrap", height: "40px", marginTop: "24px" }}><Icon name="add" /> যোগ</Btn>
        </div>
        <div style={{ maxHeight: 300, overflowY: "auto", border: `1px solid ${C.border}`, borderRadius: 8, padding: 8 }}>
          {products.map((p, idx) => (
            <div key={idx} style={{ padding: "8px 12px", borderBottom: idx !== products.length - 1 ? `1px solid ${C.border}` : "none", color: C.text, fontSize: 14 }}>
              {p}
            </div>
          ))}
        </div>
      </Card>
    </div>
  );
}
