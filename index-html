          <div style={{ padding: 12, background: "#f8fafc", borderRadius: 8, marginBottom: 8, display: "flex", justifyContent: "space-between" }}>																							
            <span>বাকি খাতা থেকে ক্যাশ কালেকশন:</span><strong>৳{fmtNum(totalReceived)}</strong>																							
          </div>																							
          <div style={{ padding: 12, background: "#ef444410", borderRadius: 8, display: "flex", justifyContent: "space-between", color: C.danger }}>																							
            <span>মার্কেটে আটকে থাকা মোট কাস্টমার বাকি:</span><strong>৳{fmtNum(totalCustDue)}</strong>																							
          </div>																							
        </div>																							
        <div>																							
          <h4 style={{ color: C.warn, marginBottom: 12 }}>🛒 মোট ব্যয় ও দায় দেনা</h4>																							
          <div style={{ padding: 12, background: "#f8fafc", borderRadius: 8, marginBottom: 8, display: "flex", justifyContent: "space-between" }}>																							
            <span>মোট মালামাল ক্রয় বিল:</span><strong>৳{fmtNum(purchases.reduce((s,r)=>s+r.total,0))}</strong>																							
          </div>																							
          <div style={{ padding: 12, background: "#f8fafc", borderRadius: 8, marginBottom: 8, display: "flex", justifyContent: "space-between" }}>																							
            <span>সাপ্লায়ারদের মোট বিল পরিশোধ:</span><strong>৳{fmtNum(totalPaid)}</strong>																							
          </div>																							
          <div style={{ padding: 12, background: "#ef444410", borderRadius: 8, display: "flex", justifyContent: "space-between", color: C.warn }}>																							
            <span>মহাজনদের কাছে আমাদের মোট দেনা:</span><strong>৳{fmtNum(totalSuppDue)}</strong>																							
          </div>																							
        </div>																							
      </div>																							
    </Card>																							
  );																							
}																							
																							
