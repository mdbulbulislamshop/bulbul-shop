import React, { useState, useMemo } from 'react';
import { ResponsiveContainer, PieChart, Pie, Cell } from 'recharts';

// ══════════════════════════════════════════════════════
//  ইউটিলিটি ও গ্লোবাল ফাংশনসমূহ (Helper Functions)
// ══════════════════════════════════════════════════════
const today = () => new Date().toISOString().split('T')[0];
const fmtNum = (num) => new Intl.NumberFormat('bn-BD').format(Number(num) || 0);
const fmtDate = (dateStr) => {
  if (!dateStr) return "-";
  const [y, m, d] = dateStr.split("-");
  return `${d}/${m}/${y}`;
};

const PIE_COLORS = ["#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899"];

// থিম কালার কনফিগ
const C = {
  primary: "#1e293b",
  accent: "#3b82f6",
  danger: "#ef4444",
  warn: "#f59e0b",
  success: "#10b981",
  text: "#334155",
  muted: "#64748b",
  border: "#e2e8f0",
};

// ══════════════════════════════════════════════════════
//  কমন UI কম্পোনেন্টসমূহ (Reusable Custom UI Elements)
// ══════════════════════════════════════════════════════
function Card({ children, style }) {
  return (
    <div style={{ background: "#ffffff", padding: 20, borderRadius: 12, boxShadow: "0 4px 6px -1px rgb(0 0 0 / 0.1)", border: `1px solid ${C.border}`, ...style }}>
      {children}
    </div>
  );
}

function DarkCard({ children, style }) {
  return (
    <div style={{ background: "#0f172a", padding: 20, borderRadius: 12, border: "1px solid #1e293b", ...style }}>
      {children}
    </div>
  );
}

function Input({ label, ...props }) {
  return (
    <div style={{ marginBottom: 14 }}>
      {label && <label style={{ display: "block", fontSize: 13, fontWeight: 600, color: C.text, marginBottom: 4 }}>{label}</label>}
      <input style={{ width: "100%", padding: "10px 12px", borderRadius: 8, border: `1px solid ${C.border}`, fontSize: 14, outline: "none", boxSizing: "border-box" }} {...props} onChange={e => props.onChange(e.target.value)} />
    </div>
  );
}

function Select({ label, options, ...props }) {
  return (
    <div style={{ marginBottom: 14 }}>
      {label && <label style={{ display: "block", fontSize: 13, fontWeight: 600, color: C.text, marginBottom: 4 }}>{label}</label>}
      <select style={{ width: "100%", padding: "10px 12px", borderRadius: 8, border: `1px solid ${C.border}`, fontSize: 14, outline: "none", background: "#fff", boxSizing: "border-box" }} {...props} onChange={e => props.onChange(e.target.value)}>
        <option value="">সিলেক্ট করুন...</option>
        {options.map((opt, i) => <option key={i} value={opt}>{opt}</option>)}
      </select>
    </div>
  );
}

function Btn({ children, color, small, ...props }) {
  return (
    <button style={{ background: color || C.accent, color: "#fff", padding: small ? "4px 8px" : "10px 16px", borderRadius: small ? 6 : 8, border: "none", cursor: "pointer", fontSize: small ? 12 : 14, fontWeight: 600, display: "inline-flex", alignItems: "center", gap: 6, ...props.style }} {...props}>
      {children}
    </button>
  );
}

function Icon({ name }) {
  const icons = {
    add: "➕", delete: "🗑️", sales: "🧾", dashboard: "📊", purchase: "🛒", 
    search: "🔎", stock: "📦", due: "👥", supplier: "🏢", bank: "🏦", report: "📈", settings: "⚙️"
  };
  return <span>{icons[name] || ""}</span>;
}

function Table({ headers, rows }) {
  return (
    <div style={{ overflowX: "auto", border: `1px solid ${C.border}`, borderRadius: 8 }}>
      <table style={{ width: "100%", borderCollapse: "collapse", textAlgin: "left" }}>
        <thead>
          <tr style={{ background: "#f8fafc", borderBottom: `1px solid ${C.border}` }}>
            {headers.map((h, i) => <th key={i} style={{ padding: "12px 16px", fontSize: 13, fontWeight: 600, color: C.muted, textAlign: "left" }}>{h}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.length === 0 ? (
            <tr><td colSpan={headers.length} style={{ padding: 20, textAlign: "center", color: C.muted, fontSize: 14 }}>কোনো ডাটা পাওয়া যায়নি</td></tr>
          ) : rows.map((row, i) => (
            <tr key={i} style={{ borderBottom: i !== rows.length - 1 ? `1px solid ${C.border}` : "none", background: i % 2 === 0 ? "#fff" : "#f8fafc" }}>
              {row.map((cell, j) => <td key={j} style={{ padding: "12px 16px", fontSize: 14, color: C.text }}>{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

// ══════════════════════════════════════════════════════
//  MAIN APP COMPONENT (মূল অ্যাপ্লিকেশন)
// ══════════════════════════════════════════════════════
export default function BulbulEnterpriseApp() {
  const [page, setPage] = useState("dashboard");
  const [toast, setToast] = useState(null);

  // কোর ডেটা স্টোর
  const [products, setProducts] = useState(["LED Bulb 12W", "Ceiling Fan 56 Inch", "Gang Switch 1 Key", "PVC Tape Blue"]);
  const [customers, setCustomers] = useState(["CASH CASTOMAR", "আল-আমিন ইলেকট্রিক", "মেসার্স রহমান ট্রেডার্স", "ঢাকা ইলেকট্রনিক্স"]);
  const [suppliers, setSuppliers] = useState(["কনফিডেন্স ব্যাটারি", "বিআরবি ক্যাবলস", "সুপার স্টার গ্রুপ"]);
  const [banks, setBanks] = useState(["হাতে নগদ ক্যাশ", "ডাচ-বাংলা ব্যাংক", "বিকাশ মার্চেন্ট"]);

  // ট্রানজেকশন খাতা
  const [purchases, setPurchases] = useState([]);
  const [sales, setSales] = useState([]);
  const [payments, setPayments] = useState([]);
  const [supplierPay, setSupplierPay] = useState([]);
  const [bankTx, setBankTx] = useState([]);

  const showToast = (msg, type = "success") => {
    setToast({ msg, type });
    setTimeout(() => setToast(null), 3000);
  };

  // রিয়েল-টাইম স্টক ম্যাপ ক্যালকুলেশন
  const stockMap = useMemo(() => {
    const map = {};
    products.forEach(p => map[p] = 0);
    purchases.forEach(p => { map[p.product] = (map[p.product] || 0) + p.qty; });
    sales.forEach(s => { map[s.product] = (map[s.product] || 0) - s.qty; });
    return map;
  }, [products, purchases, sales]);

  // মোট কাস্টমার বাকি (Total Market Due)
  const totalCustDue = useMemo(() => {
    let due = 0;
    customers.filter(c => c !== "CASH CASTOMAR").forEach(c => {
      const ts = sales.filter(s => s.customer === c).reduce((s, r) => s + r.total, 0);
      const tp = payments.filter(p => p.customer === c).reduce((s, r) => s + r.amount, 0);
      due += (ts - tp);
    });
    return due;
  }, [customers, sales, payments]);

  // মোট মহাজন দেনা (Total Supplier Due)
  const totalSuppDue = useMemo(() => {
    let due = 0;
    suppliers.forEach(s => {
      const tp = purchases.filter(p => p.supplier === s).reduce((s, r) => s + r.total, 0);
      const pd = supplierPay.filter(p => p.supplier === s).reduce((s, r) => s + r.amount, 0);
      due += (tp - pd);
    });
    return due;
  }, [suppliers, purchases, supplierPay]);

  // কাস্টমার ভিত্তিক ডাইনামিক বাকি লিস্ট
  const customerDueMap = useMemo(() => {
    const map = {};
    customers.forEach(c => {
      const ts = sales.filter(s => s.customer === c).reduce((s, r) => s + r.total, 0);
      const tp = payments.filter(p => p.customer === c).reduce((s, r) => s + r.amount, 0);
      map[c] = ts - tp;
    });
    return map;
  }, [customers, sales, payments]);

  // সাপ্লায়ার ভিত্তিক ডাইনামিক দেনা লিস্ট
  const supplierDueMap = useMemo(() => {
    const map = {};
    suppliers.forEach(s => {
      const tp = purchases.filter(p => p.supplier === s).reduce((s, r) => s + r.total, 0);
      const pd = supplierPay.filter(p => p.supplier === s).reduce((s, r) => s + r.amount, 0);
      map[s] = tp - pd;
    });
    return map;
  }, [suppliers, purchases, supplierPay]);

  return (
    <div style={{ fontFamily: "Arial, sans-serif", background: "#f1f5f9", minHeight: "100vh", display: "flex", flexDirection: "column" }}>
      {/* টোস্ট নোটিফিকেশন */}
      {toast && (
        <div style={{ position: "fixed", top: 20, right: 20, zIndex: 9999, background: toast.type === "warn" ? "#f59e0b" : "#10b981", color: "#fff", padding: "12px 24px", borderRadius: 8, fontWeight: 600, boxShadow: "0 10px 15px -3px rgba(0,0,0,0.1)" }}>
          {toast.msg}
        </div>
      )}

      {/* টপ হেডার */}
      <div style={{ background: C.primary, color: "#fff", padding: "16px 24px", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
        <h2 style={{ margin: 0, fontWeight: 700, letterSpacing: "0.5px" }}>Bulbul Enterprise <span style={{ fontSize: 12, fontWeight: 400, opacity: 0.7 }}>ERP v2.0</span></h2>
        <div style={{ fontSize: 14, background: "#334155", padding: "6px 14px", borderRadius: 20 }}>📅 আজ: {fmtDate(today())}</div>
      </div>

      {/* প্রধান ওয়ার্কস্পেস */}
      <div style={{ display: "flex", flex: 1 }}>
        {/* সাইডবার নেভিগেশন */}
        <div style={{ width: 240, background: "#1e293b", padding: "20px 10px", display: "flex", flexDirection: "column", gap: 6 }}>
          {[
            { id: "dashboard", n: "ড্যাশবোর্ড", i: "dashboard" },
            { id: "sales", n: "বিক্রয় মেমো", i: "sales" },
            { id: "purchase", n: "মাল ক্রয় এন্ট্রি", i: "purchase" },
            { id: "stock", n: "ইনভেন্টরি স্টক", i: "stock" },
            { id: "custdue", n: "কাস্টমার খতিয়ান", i: "due" },
            { id: "suppdue", n: "সাপ্লায়ার দেনা", i: "supplier" },
            { id: "bank", n: "ব্যাংক ও নগদ তহবিল", i: "bank" },
            { id: "billsearch", n: "বিল ও মেমো সার্চ", i: "search" },
            { id: "report", n: "ফাইনান্সিয়াল রিপোর্ট", i: "report" },
            { id: "master", n: "ডাটাবেজ কন্ট্রোল", i: "settings" },
          ].map(m => (
            <button key={m.id} onClick={() => setPage(m.id)} style={{ width: "100%", padding: "12px 16px", borderRadius: 8, border: "none", textAlign: "left", background: page === m.id ? C.accent : "transparent", color: page === m.id ? "#fff" : "#94a3b8", fontSize: 14, fontWeight: 600, cursor: "pointer", display: "flex", alignItems: "center", gap: 10, transition: "0.2s" }}>
              <Icon name={m.i} /> {m.n}
            </button>
          ))}
        </div>

        {/* কনটেন্ট এরিয়া */}
        <div style={{ flex: 1, padding: 24, boxSizing: "border-box", overflowY: "auto" }}>
          {page === "dashboard" && <DashboardPage C={C} sales={sales} purchases={purchases} stockMap={stockMap} totalCustDue={totalCustDue} totalSuppDue={totalSuppDue} />}
          {page === "purchase" && <PurchasePage C={C} purchases={purchases} setPurchases={setPurchases} suppliers={suppliers} products={products} showToast={showToast} />}
          {page === "sales" && <SalesPage C={C} sales={sales} setSales={setSales} customers={customers} products={products} showToast={showToast} stockMap={stockMap} purchases={purchases} />}
          {page === "billsearch" && <BillSearchPage sales={sales} purchases={purchases} />}
          {page === "stock" && <StockPage C={C} stockMap={stockMap} products={products} purchases={purchases} sales={sales} />}
          {page === "custdue" && <CustomerDuePage C={C} customers={customers} customerDue={customerDueMap} payments={payments} setPayments={setPayments} sales={sales} showToast={showToast} />}
          {page === "suppdue" && <SupplierDuePage C={C} suppliers={suppliers} supplierDue={supplierDueMap} supplierPay={supplierPay} setSupplierPay={setSupplierPay} purchases={purchases} showToast={showToast} />}
          {page === "bank" && <BankPage C={C} bankTx={bankTx} setBankTx={setBankTx} banks={banks} showToast={showToast} />}
          {page === "report" && <ReportPage C={C} sales={sales} purchases={purchases} payments={payments} supplierPay={supplierPay} totalCustDue={totalCustDue} totalSuppDue={totalSuppDue} />}
          {page === "master" && <MasterPage C={C} customers={customers} setCustomers={setCustomers} suppliers={suppliers} setSuppliers={setSuppliers} products={products} setProducts={setProducts} showToast={showToast} />}
        </div>
      </div>
    </div>
  );
}

// ══════════════════════════════════════════════════════
//  DASHBOARD PAGE SUB-COMPONENT
// ══════════════════════════════════════════════════════
function DashboardPage({ C, sales, purchases, stockMap, totalCustDue, totalSuppDue }) {
  const totalSalesVal = sales.reduce((s, r) => s + r.total, 0);
  const totalProfitVal = sales.reduce((s, r) => s + r.profit, 0);
  const totalPurchVal = purchases.reduce((s, r) => s + r.total, 0);

  // পাই চার্ট ডেটা স্ট্রাকচার নির্ধারণ
  const pieData = useMemo(() => {
    return Object.entries(stockMap)
      .filter(([, qty]) => qty > 0)
      .map(([name, qty]) => ({ name, value: qty }));
  }, [stockMap]);

  // নেগেটিভ স্টক বা ইনভ্যালিড স্টক চেক
  const negStock = Object.entries(stockMap).filter(([, v]) => v < 0);

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 20 }}>
      {/* টপ ক্যাশ কার্ড সামারি */}
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr 1fr", gap: 16 }}>
        <Card style={{ borderLeft: `5px solid ${C.accent}` }}>
          <div style={{ fontSize: 13, color: C.muted, fontWeight: 600 }}>মোট বেচাকেনা (আজ পর্যন্ত)</div>
          <div style={{ fontSize: 24, fontWeight: 700, color: C.accent, marginTop: 4 }}>৳{fmtNum(totalSalesVal)}</div>
        </Card>
        <Card style={{ borderLeft: `5px solid ${C.success}` }}>
          <div style={{ fontSize: 13, color: C.muted, fontWeight: 600 }}>মোট আনুমানিক লাভ</div>
          <div style={{ fontSize: 24, fontWeight: 700, color: C.success, marginTop: 4 }}>৳{fmtNum(totalProfitVal)}</div>
        </Card>
        <Card style={{ borderLeft: `5px solid ${C.danger}` }}>
          <div style={{ fontSize: 13, color: C.muted, fontWeight: 600 }}>মার্কেটে আটকে থাকা বাকি</div>
          <div style={{ fontSize: 24, fontWeight: 700, color: C.danger, marginTop: 4 }}>৳{fmtNum(totalCustDue)}</div>
        </Card>
        <Card style={{ borderLeft: `5px solid ${C.warn}` }}>
          <div style={{ fontSize: 13, color: C.muted, fontWeight: 600 }}>মহাজনদের কাছে দেনা</div>
          <div style={{ fontSize: 24, fontWeight: 700, color: C.warn, marginTop: 4 }}>৳{fmtNum(totalSuppDue)}</div>
        </Card>
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "1fr 380px", gap: 20 }}>
        {/* বাম দিকের কলাম: সাম্প্রতিক লেনদেন */}
        <Card>
          <h3 style={{ margin: "0 0 16px", color: C.primary }}>📈 সাম্প্রতিক গুরুত্বপূর্ণ বেচাকেনা</h3>
          <Table 
            headers={["তারিখ", "কাস্টমার নাম", "পণ্য বিবরণী", "পরিমাণ", "মোট বিল"]}
            rows={sales.slice(0, 5).map(s => [fmtDate(s.date), s.customer, s.product, `${fmtNum(s.qty)} পিস`, `৳${fmtNum(s.total)}`])}
          />
        </Card>

        {/* ডান দিকের কলাম: ডার্ক থিম স্টক অ্যালার্ট প্যানেল ও পাই চার্ট */}
        <div>
          <DarkCard>
            <h4 style={{ color: "#fff", margin: "0 0 12px", display: "flex", alignItems: "center", gap: 8 }}>🚨 ইনভেন্টরি স্টক সতর্কতা</h4>
            {negStock.length === 0 && Object.entries(stockMap).filter(([, v]) => v > 0 && v <= 5).length === 0 ? (
              <div style={{ color: "#94a3b8", fontSize: 13, padding: 10, textAlign: "center" }}>সব পণ্যের স্টক পর্যাপ্ত আছে 👍</div>
            ) : [
                ...negStock, 
                ...Object.entries(stockMap).filter(([, v]) => v > 0 && v <= 5)
              ].slice(0, 6).map(([name, qty]) => (																							
                <div key={name} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "8px 12px", borderRadius: 8, marginBottom: 6, background: qty < 0 ? "#ff6b6b10" : "#ff9f4310", border: `1px solid ${qty < 0 ? "#ff6b6b30" : "#ff9f4330"}` }}>																							
                  <div style={{ color: "#e2e8f0", fontSize: 13 }}>{name}</div>																							
                  <div style={{ fontWeight: 700, color: qty < 0 ? "#ff6b6b" : "#ff9f43" }}>{qty < 0 ? `নেগেটিভ স্টক: ${qty}` : `কম স্টক: ${qty}`} পিস</div>																							
                </div>																							
              ))																							
            }																							
                                                                                                        
            {pieData.length > 0 && (																							
              <div style={{ marginTop: 20, borderTop: "1px solid #1e293b", paddingTop: 16, display: "flex", alignItems: "center", justifyContent: "space-between" }}>																							
                <ResponsiveContainer width="50%" height={120}>																							
                  <PieChart>																							
                    <Pie data={pieData} dataKey="value" nameKey="name" cx="50%" cy="50%" innerRadius={30} outerRadius={50} paddingAngle={4}>																							
                      {pieData.map((entry, index) => <Cell key={`cell-${index}`} fill={PIE_COLORS[index % PIE_COLORS.length]} />)}																							
                    </Pie>																							
                  </PieChart>																							
                </ResponsiveContainer>																							
                <div style={{ width: "50%", display: "flex", flexDirection: "column", gap: 4 }}>																							
                  {pieData.slice(0, 5).map((d, i) => (																							
                    <div key={i} style={{ display: "flex", alignItems: "center", gap: 6, fontSize: 11, color: "#94a3b8" }}>																							
                      <div style={{ width: 8, height: 8, borderRadius: "50%", background: PIE_COLORS[i % PIE_COLORS.length] }} />																							
                      <span style={{ whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", maxWidth: "100px" }}>{d.name}</span>																							
                    </div>																							
                  ))}																							
                </div>																							
              </div>																							
            )}																							
          </DarkCard> 
        </div>
      </div>
    </div>
  );
}

// ══════════════════════════════════════════════════════
//  PURCHASE PAGE SUB-COMPONENT
// ══════════════════════════════════════════════════════
function PurchasePage({ C, purchases, setPurchases, suppliers, products, showToast }) {																							
  const [date, setDate] = useState(today());																							
  const [supplier, setSupplier] = useState("");																							
  const [product, setProduct] = useState("");																							
  const [qty, setQty] = useState("");																							
  const [price, setPrice] = useState("");																							
  const [billNo, setBillNo] = useState("");																							
																							
  const total = Number(qty || 0) * Number(price || 0);																							
																							
  const handleAdd = () => {																							
    if (!supplier || !product || !qty || !price) {																							
      showToast("সবগুলো ঘর সঠিকভাবে পূরণ করুন", "warn");																							
      return;																							
    }																							
    const newTx = { date, supplier, product, qty: Number(qty), price: Number(price), total, billNo, id: Date.now() };																							
    setPurchases([newTx, ...purchases]);																							
    setProduct(""); setQty(""); setPrice(""); setBillNo("");																							
    showToast("ক্রয় রেকর্ড সফলভাবে যোগ হয়েছে");																							
  };																							
																							
  const handleDelete = (id) => {																							
    if(confirm("আপনি কি এই ক্রয় রেকর্ডটি ডিলিট করতে চান?")) {																							
      setPurchases(purchases.filter(p => p.id !== id));																							
      showToast("রেকর্ড ডিলিট করা হয়েছে", "warn");																							
    }																							
  };																							
																							
