        <Select label="লেনদেনের ধরন" value={type} onChange={setType} options={["deposit", "withdraw"]} />																							
        <Input label="টাকার পরিমাণ" type="number" value={amount} onChange={setAmount} />																							
        <Input label="বিবরণ" value={desc} onChange={setDesc} placeholder="চেক নম্বর বা জমার কারণ" />																							
        <Btn onClick={handleAdd} color={C.success} style={{ width: "100%", justifyContent: "center" }}>লেনদেন সেভ করুন</Btn>																							
      </Card>																							
                                                                                                        
      <Card>																							
        <h3 style={{ margin: "0 0 16px", color: C.primary }}>হাতে নগদ ও ব্যাংক ব্যালেন্স স্থিতি</h3>																							
        <Table 																							
          headers={["অ্যাকাউন্ট নাম", "মোট জমা (+)", "মোট উত্তোলন (-)", "বর্তমান ব্যালেন্স"]}																							
          rows={banks.map(b => {																							
            const dep = bankTx.filter(t => t.bank === b && t.type === "deposit").reduce((s,r)=>s+r.amount, 0);																							
            const wit = bankTx.filter(t => t.bank === b && t.type === "withdraw").reduce((s,r)=>s+r.amount, 0);																							
            const bal = dep - wit;																							
            return [b, `৳${fmtNum(dep)}`, `৳${fmtNum(wit)}`, <strong key={b} style={{ color: bal >= 0 ? C.success : C.danger }}>৳{fmtNum(bal)}</strong>];																							
          })}																							
        />																							
      </Card>																							
    </div>																							
  );																							
}																							
																							
