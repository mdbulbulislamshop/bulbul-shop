function PurchasePage({ C, purchases, setPurchases, suppliers, products, showToast }) {
  const [header, setHeader] = useState({ date: today(), supplier: "", memo: "", paid: "", bank: "হাতে নগদ" });
  const [lines, setLines] = useState([{ product: "", qty: "", price: "", discount: "", _id: Date.now() }]);

  const setH = (k, v) => setHeader(h => ({ ...h, [k]: v }));
  const setLine = (idx, k, v) => {
    setLines(ls => {
      const updated = ls.map((l, i) => i === idx ? { ...l, [k]: v } : l);
      const last = updated[updated.length - 1];
      if (idx === updated.length - 1 && (last.product || last.qty || last.price)) {
        return [...updated, { product: "", qty: "", price: "", discount: "", _id: Date.now() + Math.random() }];
      }
      return updated;
    });
  };

  const lineTotal = (l) => (Number(l.qty || 0) * Number(l.price || 0)) - Number(l.discount || 0);
  const grandTotal = lines.reduce((s, l) => s + lineTotal(l), 0);
  const due = grandTotal - Number(header.paid || 0);

  const submit = () => {
    if (!header.supplier) return showToast("সাপ্লায়ারের নাম দিন", "err");
    const validLines = lines.filter(l => l.product && l.qty && l.price);
    if (validLines.length === 0) return showToast("কমপক্ষে একটি পণ্য যোগ করুন", "err");

    const memoId = Date.now();
    const entries = validLines.map((l, i) => ({
      ...header,
      product: l.product, qty: l.qty, price: l.price, discount: l.discount,
      total: lineTotal(l), due: i === 0 ? due : 0, memoId, id: memoId + i
    }));

    setPurchases(p => [...p, ...entries]);
    setHeader({ date: today(), supplier: "", memo: "", paid: "", bank: "হাতে নগদ" });
    setLines([{ product: "", qty: "", price: "", discount: "", _id: Date.now() }]);
    showToast("✅ ক্রয় ভাউচার সফলভাবে সংরক্ষিত!");
  };

  return (
    <div>
      <datalist id="dl_sup">{suppliers.map(s => <option key={s} value={s} />)}</datalist>
      <datalist id="dl_pro">{products.map(s => <option key={s} value={s} />)}</datalist>

      <Card>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))", gap: 12, marginBottom: 16, padding: "12px", background: "#eaf0fb", borderRadius: 10 }}>
          <Input label="তারিখ *" type="date" value={header.date} onChange={v => setH("date", v)} />
          <Input label="সাপ্লায়ার *" value={header.supplier} onChange={v => setH("supplier", v)} list="dl_sup" placeholder="নাম লিখুন" />
          <Input label="মেমো নং" value={header.memo} onChange={v => setH("memo", v)} placeholder="নম্বর" />
          <Input label="মোট পরিশোধ" type="number" value={header.paid} onChange={v => setH("paid", v)} placeholder="৳ টাকা" />
          <Select label="পেমেন্ট অ্যাকাউন্ট" value={header.bank} onChange={v => setH("bank", v)} options={["হাতে নগদ","DBBL","BRAC BANK","IBBL","bKash"]} />
        </div>

        {lines.map((l, idx) => (
          <div key={l._id} style={{ display: "flex", gap: 8, marginBottom: 8, alignItems: "center" }}>
            <div style={{ flex: 3 }}><input value={l.product} onChange={e => setLine(idx, "product", e.target.value)} list="dl_pro" placeholder="পণ্যের নাম" style={{ width: "100%", padding: 8, borderRadius: 6, border: "1px solid #ccc" }} /></div>
            <div style={{ flex: 1 }}><input type="number" value={l.qty} onChange={e => setLine(idx, "qty", e.target.value)} placeholder="পরিমাণ" style={{ width: "100%", padding: 8, borderRadius: 6, border: "1px solid #ccc" }} /></div>
            <div style={{ flex: 1 }}><input type="number" value={l.price} onChange={e => setLine(idx, "price", e.target.value)} placeholder="ক্রয়মূল্য" style={{ width: "100%", padding: 8, borderRadius: 6, border: "1px solid #ccc" }} /></div>
            <div style={{ flex: 1 }}><input type="number" value={l.discount} onChange={e => setLine(idx, "discount", e.target.value)} placeholder="ছাড়" style={{ width: "100%", padding: 8, borderRadius: 6, border: "1px solid #ccc" }} /></div>
          </div>
        ))}

        <div style={{ display: "flex", justifyContent: "space-between", background: "#f8fafc", padding: 12, borderRadius: 8, marginTop: 12 }}>
          <div>সর্বমোট: <strong>৳{fmtNum(grandTotal)}</strong> | বাকি: <strong style={{ color: "red" }}>৳{fmtNum(due)}</strong></div>
          <Btn onClick={submit}>সংরক্ষণ করুন 💾</Btn>
        </div>
      </Card>
    </div>
  );
}

