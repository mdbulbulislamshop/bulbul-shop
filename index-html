// ── আইকন ──────────────────────────────────────────────
const Icon = ({ name, size = 16 }) => {
  const icons = {
    home: "🏠", purchase: "🛒", sales: "💰", stock: "📦",
    bank: "🏦", customer: "👥", supplier: "🏪", report: "📊",
    add: "➕", delete: "🗑️", edit: "✏️", save: "💾",
    warning: "⚠️", ok: "✅", search: "🔍", close: "✖️",
    money: "💵", arrow_up: "↑", arrow_down: "↓", list: "📋",
    pay: "💳", due: "🔴", paid: "🟢", partial: "🟡",
  };
  return <span style={{ fontSize: size }}>{icons[name] || "•"}</span>;
};

// ── তারিখ ও সংখ্যা হেল্পার ──────────────────────────────
const today = () => new Date().toISOString().split("T")[0];
const fmtDate = (d) => {
  if (!d) return "";
  const dt = new Date(d);
  return dt.toLocaleDateString("bn-BD", { day: "2-digit", month: "short", year: "numeric" });
};
const fmtNum = (n) => Number(n || 0).toLocaleString("bn-BD");

