  "INTEX 23M5","INTEX 24M5","INTEX T STAR MALTY","BEST CTOP 2m","BEST CTOP 5m",
  "BEST LINE 315","BEST LINE 415","BEST LINE 515","MAX017 10F","MAX017 20F",
  "CAPACITOR 3.5","CAPACITOR 2.5","KOHLINUR 30A","KOHLINUR 15A","DP SWICH H",
