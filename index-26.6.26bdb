  el.innerHTML=DB.de.length?[...DB.de].reverse().map(r=>`
    <div class="li">
      <div class="lic" style="background:var(--ob)">💸</div>
      <div class="lib"><div class="lit">${r.type}</div><div class="lis">${r.detail||'-'} | ${r.source} | ${r.date}</div></div>
      <div class="lir"><div class="lia" style="color:var(--o)">${fmt(r.amt)}</div></div>
      <button class="db" onclick="DB.de=DB.de.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`).join(''):'<div class="empty"><div class="ei">💸</div><p>কোনো খরচ নেই</p></div>';
  const tot=DB.de.reduce((s,r)=>s+r.amt,0);
  const el2=$('de-tot');if(el2)el2.textContent=fmt(tot);
}

function addME() {
  const amt=nv('mea');
  if(!amt) return toast('পরিমাণ দিন','e');
  DB.me.push({id:Date.now(),type:v('met'),month:v('mem'),source:v('mes'),amt});
  save();renderAll();
  $('mea').value='';
  toast('মাসিক খরচ যোগ হয়েছে!');
}
function renderME() {
  const el=$('me-list');if(!el)return;
  el.innerHTML=DB.me.length?[...DB.me].reverse().map(r=>`
    <div class="li">
      <div class="lic" style="background:#ede9fe">🏢</div>
      <div class="lib"><div class="lit">${r.type}</div><div class="lis">${r.month||'-'} | ${r.source}</div></div>
      <div class="lir"><div class="lia" style="color:#7c3aed">${fmt(r.amt)}</div></div>
      <button class="db" onclick="DB.me=DB.me.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`).join(''):'<div class="empty"><div class="ei">🏢</div><p>কোনো মাসিক খরচ নেই</p></div>';
  const tot=DB.me.reduce((s,r)=>s+r.amt,0);
  const el2=$('me-tot');if(el2)el2.textContent=fmt(tot);
}

// ===== STOCK =====
function addStock() {
  const name=v('stn').trim(), qty=nv('stq');
  if(!name||!qty) return toast('নাম ও পরিমাণ দিন','e');
  const ex=DB.stk.find(s=>s.name===name);
  if(ex){ex.qty+=qty;ex.buyPrice=nv('stb')||ex.buyPrice;ex.sellPrice=nv('sts')||ex.sellPrice;ex.minQty=nv('stmn')||ex.minQty;}
  else DB.stk.push({id:Date.now(),name,qty,buyPrice:nv('stb'),sellPrice:nv('sts'),minQty:nv('stmn')});
  save();renderAll();
  ['stn','stq','stb','sts','stmn'].forEach(id=>$(id).value='');
  toast('স্টক আপডেট!');
}
function renderStock(q='') {
  const allStk=[...EXL.stk,...DB.stk.filter(s=>!EXL.stk.find(e=>e.name===s.name))];
  const rows=allStk.filter(r=>!q||r.name.toLowerCase().includes(q.toLowerCase()));
  const el=$('stk-list');if(!el)return;
  el.innerHTML=rows.length?rows.map(r=>{
    const val=r.qty*r.buyPrice;
    const st=r.qty<=0?'bdr2':r.minQty&&r.qty<=r.minQty?'bdo':'bdg';
    const stx=r.qty<=0?'❌ শেষ':r.minQty&&r.qty<=r.minQty?'⚠️ কম':'✅ আছে';
    return`<div class="li">
      <div class="lic" style="background:var(--ob)">📦</div>
      <div class="lib"><div class="lit">${r.name}</div><div class="lis">ক্রয়: ${fmtN(r.buyPrice)} | বিক্রয়: ${fmtN(r.sellPrice)} | স্টক: ${r.qty}টি</div></div>
      <div class="lir"><div class="lia">${fmt(val)}</div><span class="bd ${st}">${stx}</span></div>
    </div>`;
  }).join(''):'<div class="empty"><div class="ei">📦</div><p>কোনো স্টক নেই</p></div>';
  const tot=rows.reduce((s,r)=>s+r.qty*r.buyPrice,0);
  const el2=$('stk-tot');if(el2)el2.textContent=fmt(tot);
}

// ===== DAMAGED =====
function addDamaged() {
  const date=v('dmd'),prod=v('dmp').trim(),qty=nv('dmq');
  if(!date||!prod||!qty) return toast('তারিখ, পণ্য ও পরিমাণ দিন','e');
  const repair=nv('dmr'),sell=nv('dmv');
  const stk=[...EXL.stk,...DB.stk].find(s=>s.name===prod);
  const cost=(stk?stk.buyPrice:0)*qty;
  const loss=cost+repair-sell;
  DB.dmg.push({id:Date.now(),date,product:prod,qty,customer:v('dmc'),status:v('dms'),repair,sell,loss});
  save();renderAll();
  ['dmp','dmq','dmc','dmr','dmv'].forEach(id=>$(id).value='');
  $('dmr').value=0;$('dmv').value=0;
  toast('নষ্ট মাল যোগ হয়েছে!');
}
function renderDmg() {
  const el=$('dm-list');if(!el)return;
  const sc={মেরামতযোগ্য:'bdo',অকেজো:'bdr2','Supplier ফেরত':'bdb'};
  el.innerHTML=DB.dmg.length?[...DB.dmg].reverse().map(r=>`
    <div class="li">
      <div class="lic" style="background:var(--rb)">⚠️</div>
      <div class="lib"><div class="lit">${r.product} (${r.qty}টি)</div><div class="lis">${r.customer||'-'} | ${r.date}</div><span class="bd ${sc[r.status]||'bdb'}">${r.status}</span></div>
      <div class="lir"><div class="lia loss">${fmt(r.loss)}</div><div style="font-size:10px;color:var(--mu)">ক্ষতি</div></div>
      <button class="db" onclick="DB.dmg=DB.dmg.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`).join(''):'<div class="empty"><div class="ei">⚠️</div><p>কোনো নষ্ট মাল নেই</p></div>';
  const tot=DB.dmg.reduce((s,r)=>s+r.loss,0);
  const el2=$('dm-tot');if(el2)el2.textContent=fmt(tot);
}

// ===== SUPPLIER DUE =====
function addSupDue() {
  const name=v('sudn').trim();
  if(!name) return toast('নাম দিন','e');
  if(DB.sud.find(s=>s.name===name)) return toast('ইতিমধ্যে আছে','e');
  DB.sud.push({id:Date.now(),name,prev:nv('sudp'),note:v('sudt')});
  save();renderAll();
  ['sudn','sudp','sudt'].forEach(id=>$(id).value='');
  toast('Supplier যোগ হয়েছে!');
}
function renderSud() {
  const el=$('sud-list');if(!el)return;
  let tot=0;
  el.innerHTML=DB.sud.length?DB.sud.map(r=>{
    const b=DB.pur.filter(p=>p.supplier===r.name).reduce((a,p)=>a+p.grand,0);
    const pd=DB.pur.filter(p=>p.supplier===r.name).reduce((a,p)=>a+p.paid,0);
    const due=b-pd+r.prev; tot+=due;
    return`<div class="li">
      <div class="lic" style="background:#dbeafe">🏪</div>
      <div class="lib"><div class="lit">${r.name}</div><div class="lis">ক্রয়: ${fmt(b)} | পরিশোধ: ${fmt(pd)} | আগের: ${fmt(r.prev)}</div></div>
      <div class="lir"><div class="lia loss">${fmt(due)}</div><div style="font-size:10px;color:var(--mu)">মোট বাকি</div></div>
      <button class="db" onclick="DB.sud=DB.sud.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`;
  }).join(''):'<div class="empty"><div class="ei">🏪</div><p>কোনো Supplier নেই</p></div>';
  const el2=$('sud-tot');if(el2)el2.textContent=fmt(tot);
}

// ===== CUSTOMER DUE =====
function addCusDue() {
  const name=v('cudn').trim();
  if(!name) return toast('নাম দিন','e');
  if(DB.cud.find(c=>c.name===name)) return toast('ইতিমধ্যে আছে','e');
  DB.cud.push({id:Date.now(),name,prev:nv('cudp'),note:v('cudt')});
  save();renderAll();
  ['cudn','cudp','cudt'].forEach(id=>$(id).value='');
  toast('Customer যোগ হয়েছে!');
}
function renderCud() {
  const el=$('cud-list');if(!el)return;
  let tot=0;
  el.innerHTML=DB.cud.length?DB.cud.map(r=>{
    const s=DB.sal.filter(x=>x.customer===r.name).reduce((a,x)=>a+x.net,0);
    const pd=DB.sal.filter(x=>x.customer===r.name).reduce((a,x)=>a+x.paid,0);
    const due=s-pd+r.prev; tot+=due;
    return`<div class="li">
      <div class="lic" style="background:var(--gb)">👥</div>
      <div class="lib"><div class="lit">${r.name}</div><div class="lis">বিক্রয়: ${fmt(s)} | পরিশোধ: ${fmt(pd)} | আগের: ${fmt(r.prev)}</div></div>
      <div class="lir"><div class="lia loss">${fmt(due)}</div><div style="font-size:10px;color:var(--mu)">মোট বাকি</div></div>
      <button class="db" onclick="DB.cud=DB.cud.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`;
  }).join(''):'<div class="empty"><div class="ei">👥</div><p>কোনো Customer নেই</p></div>';
  const el2=$('cud-tot');if(el2)el2.textContent=fmt(tot);
}

// ===== BANK =====
function addBank() {
  const date=v('bnd'),amt=nv('bna');
  if(!date||!amt) return toast('তারিখ ও পরিমাণ দিন','e');
  DB.bnk.push({id:Date.now(),date,bank:v('bnk'),type:v('bnt'),amt,reason:v('bnr')});
  save();renderAll();
  $('bna').value='';$('bnr').value='';
  toast('লেনদেন যোগ হয়েছে!');
}
function renderBank() {
  const bs=Object.keys(DB.bob);
  const el=$('bnk-sum');if(!el)return;
  el.innerHTML=bs.map(b=>{
    const tin=DB.bnk.filter(t=>t.bank===b&&t.type==='জমা').reduce((s,t)=>s+t.amt,0);
    const tout=DB.bnk.filter(t=>t.bank===b&&t.type==='উত্তোলন').reduce((s,t)=>s+t.amt,0);
    const bal=DB.bob[b]+tin-tout;
    return`<div class="br"><div><div class="brn">${b}</div><div class="brs">জমা: ${fmtN(tin)} | উত্তোলন: ${fmtN(tout)}</div></div><div class="brv">${fmt(bal)}</div></div>`;
  }).join('');
  const el2=$('bnk-list');if(!el2)return;
  el2.innerHTML=[...DB.bnk].reverse().length?[...DB.bnk].reverse().map(r=>`
    <div class="li">
      <div class="lic" style="background:${r.type==='জমা'?'var(--gb)':'var(--rb)'}">${r.type==='জমা'?'⬆️':'⬇️'}</div>
      <div class="lib"><div class="lit">${r.bank}</div><div class="lis">${r.reason||'-'} | ${r.date}</div><span class="bd ${r.type==='জমা'?'bdg':'bdr2'}">${r.type}</span></div>
      <div class="lir"><div class="lia ${r.type==='জমা'?'profit':'loss'}">${fmt(r.amt)}</div></div>
      <button class="db" onclick="DB.bnk=DB.bnk.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`).join(''):'<div class="empty"><div class="ei">🏦</div><p>কোনো লেনদেন নেই</p></div>';
}

// ===== LOAN =====
function addLoan() {
  const name=v('lnn').trim(),amt=nv('lna');
  if(!name||!amt) return toast('নাম ও পরিমাণ দিন','e');
  const paid=nv('lnp');
  DB.ln.push({id:Date.now(),name,type:v('lnt'),amt,rate:nv('lnr'),install:nv('lni'),paid,due:amt-paid});
  save();renderAll();
  ['lnn','lna','lnr','lni','lnp'].forEach(id=>$(id).value='');
  toast('Loan যোগ হয়েছে!');
}
function renderLoan() {
  const el=$('ln-list');if(!el)return;
  el.innerHTML=DB.ln.length?DB.ln.map(r=>`
    <div class="li">
      <div class="lic" style="background:var(--rb)">💳</div>
      <div class="lib"><div class="lit">${r.name}</div><span class="bd bdb">${r.type}</span><div class="lis">মূল: ${fmt(r.amt)} | পরিশোধ: ${fmt(r.paid)} | কিস্তি: ${fmt(r.install)}/মাস</div></div>
      <div class="lir"><div class="lia loss">${fmt(r.due)}</div><div style="font-size:10px;color:var(--mu)">বাকি</div></div>
      <button class="db" onclick="DB.ln=DB.ln.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`).join(''):'<div class="empty"><div class="ei">💳</div><p>কোনো Loan নেই</p></div>';
  const tot=DB.ln.reduce((s,r)=>s+r.due,0);
  const el2=$('ln-tot');if(el2)el2.textContent=fmt(tot);
}

// ===== P&L =====
function renderPL() {
  const el=$('pl-list');if(!el)return;
  const dates=[...new Set([...DB.sal.map(r=>r.date),...DB.pur.map(r=>r.date),...DB.de.map(r=>r.date)])].sort().reverse();
  let totPL=0;
  el.innerHTML=dates.length?dates.map(d=>{
    const s=DB.sal.filter(r=>r.date===d).reduce((a,r)=>a+r.net,0);
    const p=DB.pur.filter(r=>r.date===d).reduce((a,r)=>a+r.grand,0);
    const e=DB.de.filter(r=>r.date===d).reduce((a,r)=>a+r.amt,0);
    const dm=DB.dmg.filter(r=>r.date===d).reduce((a,r)=>a+r.loss,0);
    const pl=s-p-e-dm; totPL+=pl;
    const pct=s?((pl/s)*100).toFixed(1):0;
    return`<div class="plr">
      <div class="pld">${d}</div>
      <div class="plg">
        <div class="pls"><div class="pll">বিক্রয়</div><div class="plv profit">${fmtN(s)}</div></div>
        <div class="pls"><div class="pll">ক্রয়+খরচ</div><div class="plv" style="color:var(--o)">${fmtN(p+e+dm)}</div></div>
        <div class="pls"><div class="pll">লাভ/লস</div><div class="plv ${pl>=0?'profit':'loss'}">${fmtN(pl)}</div></div>
      </div>
      <div class="plp ${pl>=0?'profit':'loss'}">${pl>=0?'▲':'▼'} ${fmt(Math.abs(pl))} (${pct}%)</div>
    </div>`;
  }).join(''):'<div class="empty"><div class="ei">📈</div><p>কোনো ডেটা নেই</p></div>';
  const el2=$('pl-tot');if(el2){el2.textContent=fmt(totPL);el2.className='trv '+(totPL>=0?'profit':'loss');}
}

// ===== DASHBOARD =====
function renderDash() {
  const totS=DB.sal.reduce((s,r)=>s+r.net,0);
  const totP=DB.pur.reduce((s,r)=>s+r.grand,0);
  const totDE=DB.de.reduce((s,r)=>s+r.amt,0);
  const totME=DB.me.reduce((s,r)=>s+r.amt,0);
  const totE=totDE+totME;
  const totDm=DB.dmg.reduce((s,r)=>s+r.loss,0);
  const profit=totS-totP-totE-totDm;
  const allStk=[...EXL.stk,...DB.stk.filter(s=>!EXL.stk.find(e=>e.name===s.name))];
  const totStk=allStk.reduce((s,r)=>s+r.qty*r.buyPrice,0);
  const totCdu=DB.cud.reduce((s,r)=>{
    const sold=DB.sal.filter(x=>x.customer===r.name).reduce((a,x)=>a+x.net,0);
    const paid=DB.sal.filter(x=>x.customer===r.name).reduce((a,x)=>a+x.paid,0);
    return s+(sold-paid)+r.prev;
  },0);
  const totSdu=DB.sud.reduce((s,r)=>{
    const b=DB.pur.filter(x=>x.supplier===r.name).reduce((a,x)=>a+x.grand,0);
    const pd=DB.pur.filter(x=>x.supplier===r.name).reduce((a,x)=>a+x.paid,0);
    return s+(b-pd)+r.prev;
  },0);
  const t=today();
  const tS=DB.sal.filter(r=>r.date===t).reduce((a,r)=>a+r.net,0);
  const tP=DB.pur.filter(r=>r.date===t).reduce((a,r)=>a+r.grand,0);
  const tE=DB.de.filter(r=>r.date===t).reduce((a,r)=>a+r.amt,0);
  const tPL=tS-tP-tE;

  const s=id=>$(id);
  if(s('c-sal'))s('c-sal').textContent=fmt(totS);
  if(s('c-pur'))s('c-pur').textContent=fmt(totP);
  if(s('c-pro')){s('c-pro').textContent=fmt(profit);s('c-pro').className='mv '+(profit>=0?'profit':'loss');}
  if(s('c-exp'))s('c-exp').textContent=fmt(totE);
  if(s('c-stk'))s('c-stk').textContent=fmt(totStk);
  if(s('c-dmg'))s('c-dmg').textContent=fmt(totDm);
  if(s('c-cdu'))s('c-cdu').textContent=fmt(totCdu);
  if(s('c-sdu'))s('c-sdu').textContent=fmt(totSdu);
  if(s('t-sal'))s('t-sal').textContent=fmt(tS);
  if(s('t-pur'))s('t-pur').textContent=fmt(tP);
  if(s('t-exp'))s('t-exp').textContent=fmt(tE);
  if(s('t-pro')){s('t-pro').textContent=fmt(tPL);s('t-pro').className='tcv '+(tPL>=0?'profit':'loss');}

  const bel=$('dash-bank');if(!bel)return;
  bel.innerHTML=Object.keys(DB.bob).map(b=>{
    const tin=DB.bnk.filter(t=>t.bank===b&&t.type==='জমা').reduce((a,t)=>a+t.amt,0);
    const tout=DB.bnk.filter(t=>t.bank===b&&t.type==='উত্তোলন').reduce((a,t)=>a+t.amt,0);
    return`<div class="br"><div><div class="brn">${b}</div><div class="brs">আগের: ${fmtN(DB.bob[b])} | জমা: ${fmtN(tin)} | উত্তোলন: ${fmtN(tout)}</div></div><div class="brv">${fmt(DB.bob[b]+tin-tout)}</div></div>`;
  }).join('');
}

// ===== RENDER ALL =====
function renderAll() {
  renderDash();renderPur();renderSal();
  renderDE();renderME();renderStock();
  renderDmg();renderSud();renderCud();
  renderBank();renderLoan();renderPL();
}

// ===== SAVE/LOAD =====
function save(){try{localStorage.setItem('biz26',JSON.stringify(DB));}catch(e){}}
function loadSaved(){try{const d=localStorage.getItem('biz26');if(d)Object.assign(DB,JSON.parse(d));}catch(e){}}

function exportData(){
  const blob=new Blob([JSON.stringify(DB,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=`ব্যবসার_ডেটা_${today()}.json`;
  a.click();toast('ডেটা সেভ হয়েছে!');
}
function importData(e){
  const file=e.target.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=ev=>{try{Object.assign(DB,JSON.parse(ev.target.result));save();renderAll();toast('ডেটা লোড হয়েছে!');}catch{toast('ফাইল সঠিক নয়','e');}};
  reader.readAsText(file);e.target.value='';
}

// ===== INIT =====
document.addEventListener('DOMContentLoaded',()=>{
  const now=new Date();
  const mn=['জানু','ফেব','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টে','অক্টো','নভে','ডিসে'];
  $('hdate').textContent=`${now.getDate()} ${mn[now.getMonth()]} ${now.getFullYear()}`;
  const t=today();
  ['pd','sd','ded','dmd','bnd'].forEach(id=>{const el=$(id);if(el)el.value=t;});
  const mel=$('mem');if(mel)mel.value=t.substring(0,7);
  loadSaved();
  addPurLine();
  addSalLine();
  renderAll();
});
</script>
</body>
</html>

