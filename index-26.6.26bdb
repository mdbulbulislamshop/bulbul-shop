<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>⚡ ইলেকট্রিক ব্যবসা</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap');
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --p:#1a3a5c;--pl:#2563a8;--g:#059669;--gb:#d1fae5;
  --r:#dc2626;--rb:#fee2e2;--o:#ea580c;--ob:#ffedd5;
  --a:#f59e0b;--bg:#f1f5f9;--card:#fff;--bdr:#e2e8f0;
  --mt:#1e293b;--mu:#64748b;--nh:60px;--hh:52px
}
body{font-family:'Hind Siliguri',sans-serif;background:var(--bg);color:var(--mt);font-size:14px;padding-top:var(--hh);padding-bottom:var(--nh)}
/* HEADER */
.hdr{position:fixed;top:0;left:0;right:0;height:var(--hh);background:var(--p);display:flex;align-items:center;justify-content:space-between;padding:0 14px;z-index:100;box-shadow:0 2px 8px rgba(0,0,0,.2)}
.hdr-l{display:flex;align-items:center;gap:8px}
.hdr-l span{font-size:22px}
.hdr-l h1{color:#fff;font-size:14px;font-weight:700}
.hdr-l p{color:rgba(255,255,255,.5);font-size:10px}
.hdr-r{display:flex;gap:8px}
.ibt{width:34px;height:34px;border-radius:8px;border:none;background:rgba(255,255,255,.15);color:#fff;font-size:15px;cursor:pointer;display:flex;align-items:center;justify-content:center}
/* BOTTOM NAV */
.bnav{position:fixed;bottom:0;left:0;right:0;height:var(--nh);background:#fff;border-top:1px solid var(--bdr);display:flex;z-index:100;box-shadow:0 -2px 8px rgba(0,0,0,.08)}
.nt{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border:none;background:none;color:var(--mu);font-family:inherit;font-size:10px;font-weight:500;cursor:pointer;position:relative;padding:6px 2px}
.nt .ni{font-size:20px;line-height:1}
.nt.active{color:var(--pl)}
.nt.active::before{content:'';position:absolute;top:0;left:20%;right:20%;height:3px;background:var(--pl);border-radius:0 0 4px 4px}
/* PAGES */
.pg{display:none;padding:12px}
.pg.active{display:block}
/* CARDS SCROLL */
.csc{display:flex;gap:10px;overflow-x:auto;padding-bottom:6px;margin-bottom:14px;scrollbar-width:none}
.csc::-webkit-scrollbar{display:none}
.mc{min-width:130px;background:#fff;border-radius:12px;padding:12px;flex-shrink:0;border:1px solid var(--bdr);border-top:3px solid var(--pl)}
.mc .ml{font-size:10px;color:var(--mu);font-weight:500;margin-bottom:2px}
.mc .mv{font-size:15px;font-weight:700}
/* TODAY */
.tgd{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.tc{background:#fff;border-radius:12px;padding:12px;border:1px solid var(--bdr)}
.tc .tci{font-size:18px;margin-bottom:4px}
.tc .tcl{font-size:10px;color:var(--mu)}
.tc .tcv{font-size:15px;font-weight:700}
/* SECTION TITLE */
.st{font-size:13px;font-weight:700;color:var(--p);margin-bottom:10px;display:flex;align-items:center;gap:6px}
/* FORM CARD */
.fc{background:#fff;border-radius:14px;padding:14px;margin-bottom:12px;border:1px solid var(--bdr)}
.ft{font-size:14px;font-weight:700;color:var(--p);margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--bdr)}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.ff{margin-bottom:10px}
.fg{display:flex;flex-direction:column;gap:4px}
.fg label{font-size:11px;font-weight:600;color:var(--mu)}
input,select{padding:10px 12px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:14px;color:var(--mt);background:#fff;width:100%;-webkit-appearance:none}
input:focus,select:focus{outline:none;border-color:var(--pl);box-shadow:0 0 0 3px rgba(37,99,168,.1)}
input[readonly]{background:#f8fafc;color:var(--mu)}
/* BTN */
.btn{width:100%;padding:13px;border-radius:12px;border:none;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:6px}
.bp{background:var(--pl);color:#fff}
.bg{background:var(--g);color:#fff}
.ba{background:var(--a);color:#fff}
/* TABLE CARD */
.tc2{background:#fff;border-radius:14px;border:1px solid var(--bdr);overflow:hidden;margin-bottom:12px}
.th2{padding:12px 14px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between}
.th2 h3{font-size:13px;font-weight:700;color:var(--p)}
.si{padding:8px 12px;border:1.5px solid var(--bdr);border-radius:8px;font-size:13px;width:140px;font-family:inherit}
/* LIST ITEM */
.li{padding:11px 14px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:10px}
.li:last-child{border-bottom:none}
.lic{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0}
.lib{flex:1;min-width:0}
.lit{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lis{font-size:11px;color:var(--mu);margin-top:1px}
.lir{text-align:right;flex-shrink:0}
.lia{font-size:14px;font-weight:700}
.db{width:32px;height:32px;border:none;border-radius:8px;background:var(--rb);color:var(--r);font-size:14px;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center}
/* TOTAL ROW */
.tr2{padding:11px 14px;background:#f8fafc;border-top:2px solid var(--bdr);display:flex;justify-content:space-between;align-items:center}
.tr2 .trl{font-size:12px;font-weight:600;color:var(--mu)}
.tr2 .trv{font-size:15px;font-weight:700;color:var(--p)}
/* BADGE */
.bd{display:inline-block;padding:3px 8px;border-radius:20px;font-size:10px;font-weight:600}
.bdg{background:var(--gb);color:var(--g)}
.bdr2{background:var(--rb);color:var(--r)}
.bdo{background:var(--ob);color:var(--o)}
.bdb{background:#dbeafe;color:var(--pl)}
/* TABS */
.tabs{display:flex;background:#fff;border-radius:12px;padding:4px;margin-bottom:12px;border:1px solid var(--bdr)}
.tab{flex:1;padding:9px;border:none;border-radius:10px;background:none;font-family:inherit;font-size:12px;font-weight:600;color:var(--mu);cursor:pointer}
.tab.active{background:var(--pl);color:#fff}
.tp{display:none}
.tp.active{display:block}
/* BANK ROW */
.br{padding:11px 14px;border-bottom:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between}
.br:last-child{border-bottom:none}
.brn{font-size:13px;font-weight:600}
.brs{font-size:10px;color:var(--mu)}
.brv{font-size:14px;font-weight:700;color:var(--p)}
/* PL ROW */
.plr{padding:11px 14px;border-bottom:1px solid var(--bdr)}
.plr:last-child{border-bottom:none}
.pld{font-size:11px;color:var(--mu);margin-bottom:6px}
.plg{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.pls .pll{font-size:9px;color:var(--mu)}
.pls .plv{font-size:12px;font-weight:700}
.plp{font-size:14px;font-weight:700;text-align:right;margin-top:6px}
/* COLORS */
.profit{color:var(--g)}
.loss{color:var(--r)}
/* EMPTY */
.empty{padding:36px 20px;text-align:center;color:var(--mu)}
.empty .ei{font-size:36px;margin-bottom:8px}
.empty p{font-size:13px}
/* TOAST */
.tw{position:fixed;top:62px;left:12px;right:12px;z-index:999}
.tst{background:#1e293b;color:#fff;padding:11px 14px;border-radius:10px;font-size:13px;font-weight:500;margin-bottom:6px;display:flex;align-items:center;gap:8px;animation:fi .3s ease;box-shadow:0 4px 14px rgba(0,0,0,.2)}
.tst.s{border-left:4px solid var(--g)}
.tst.e{border-left:4px solid var(--r)}
@keyframes fi{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
/* MULTI LINE */
.pline{display:grid;grid-template-columns:2.5fr 1fr 1.2fr 1.2fr 36px;gap:6px;margin-bottom:8px;align-items:center}
.pline input{padding:9px 10px;font-size:13px}
.add-line-btn{width:100%;padding:10px;border:2px dashed var(--bdr);border-radius:10px;background:none;font-family:inherit;font-size:13px;color:var(--mu);cursor:pointer;margin-bottom:10px}
.add-line-btn:hover{border-color:var(--pl);color:var(--pl)}
.grand-box{background:var(--gb);border-radius:10px;padding:10px 14px;margin:8px 0;display:flex;justify-content:space-between;align-items:center}
.grand-box.sale{background:#dbeafe}
.grand-lbl{font-size:12px;font-weight:600;color:var(--g)}
.grand-box.sale .grand-lbl{color:var(--pl)}
.grand-val{font-size:17px;font-weight:700;color:var(--g)}
.grand-box.sale .grand-val{color:var(--pl)}
.line-head{display:grid;grid-template-columns:2.5fr 1fr 1.2fr 1.2fr 36px;gap:6px;margin-bottom:4px}
.line-head span{font-size:10px;font-weight:600;color:var(--mu);text-align:center}
.line-head span:first-child{text-align:left}
</style>
</head>
<body>

<header class="hdr">
  <div class="hdr-l">
    <span>⚡</span>
    <div><h1>ইলেকট্রিক ব্যবসা</h1><p id="hdate">লোড হচ্ছে...</p></div>
  </div>
  <div class="hdr-r">
    <button class="ibt" onclick="exportData()" title="সেভ">💾</button>
    <button class="ibt" onclick="document.getElementById('impF').click()" title="লোড">📂</button>
    <input type="file" id="impF" style="display:none" accept=".json" onchange="importData(event)">
  </div>
</header>

<!-- ===== HOME ===== -->
<div class="pg active" id="pg-home">
  <div class="csc">
    <div class="mc" style="border-top-color:var(--g)"><div class="ml">💰 মোট বিক্রয়</div><div class="mv profit" id="c-sal">৳ ০</div></div>
    <div class="mc" style="border-top-color:var(--pl)"><div class="ml">🛒 মোট ক্রয়</div><div class="mv" id="c-pur">৳ ০</div></div>
    <div class="mc" style="border-top-color:var(--a)"><div class="ml">✅ মোট লাভ</div><div class="mv" id="c-pro">৳ ০</div></div>
    <div class="mc" style="border-top-color:var(--o)"><div class="ml">💸 মোট খরচ</div><div class="mv" id="c-exp">৳ ০</div></div>
    <div class="mc" style="border-top-color:#7c3aed"><div class="ml">📦 স্টক মূল্য</div><div class="mv" id="c-stk">৳ ০</div></div>
    <div class="mc" style="border-top-color:var(--r)"><div class="ml">⚠️ নষ্ট মাল</div><div class="mv loss" id="c-dmg">৳ ০</div></div>
    <div class="mc" style="border-top-color:var(--g)"><div class="ml">👥 Customer বাকি</div><div class="mv loss" id="c-cdu">৳ ০</div></div>
    <div class="mc" style="border-top-color:var(--o)"><div class="ml">🏪 Supplier বাকি</div><div class="mv loss" id="c-sdu">৳ ০</div></div>
  </div>

  <div class="st">📅 আজকের হিসাব</div>
  <div class="tgd">
    <div class="tc"><div class="tci">💰</div><div class="tcl">আজকের বিক্রয়</div><div class="tcv profit" id="t-sal">৳ ০</div></div>
    <div class="tc"><div class="tci">🛒</div><div class="tcl">আজকের ক্রয়</div><div class="tcv" id="t-pur" style="color:var(--pl)">৳ ০</div></div>
    <div class="tc"><div class="tci">💸</div><div class="tcl">আজকের খরচ</div><div class="tcv" id="t-exp" style="color:var(--o)">৳ ০</div></div>
    <div class="tc"><div class="tci">📈</div><div class="tcl">আজকের লাভ/লস</div><div class="tcv" id="t-pro">৳ ০</div></div>
  </div>

  <div class="st">🏦 ব্যাংক ও নগদ</div>
  <div class="tc2" id="dash-bank"></div>
</div>

<!-- ===== PURCHASE ===== -->
<div class="pg" id="pg-purchase">
  <div class="fc">
    <div class="ft">🛒 ক্রয় এন্ট্রি</div>
    <!-- হেডার — একবার -->
    <div class="fr">
      <div class="fg"><label>তারিখ *</label><input type="date" id="pd"></div>
      <div class="fg"><label>মেমো নং</label><input type="text" id="pm" placeholder="নম্বর"></div>
    </div>
    <div class="ff fg">
      <label>Supplier নাম *</label>
      <input type="text" id="ps" placeholder="Supplier লিখুন..." autocomplete="off" oninput="showSupDrop(this.value)" onblur="hideDropAfter('sdrop')" onfocus="showSupDrop(this.value)">
      <div id="sdrop" style="display:none;position:relative;z-index:50;background:#fff;border:1.5px solid var(--pl);border-radius:10px;max-height:180px;overflow-y:auto;margin-top:2px;box-shadow:0 4px 16px rgba(0,0,0,.1)"></div>
    </div>
    <div class="fr">
      <div class="fg"><label>পরিশোধ</label><input type="number" id="pp" placeholder="০" value="0" min="0"></div>
      <div class="fg"><label>মন্তব্য</label><input type="text" id="pnt" placeholder="ঐচ্ছিক"></div>
    </div>

    <!-- পণ্যের লাইন -->
    <div style="border-top:1px solid var(--bdr);padding-top:12px;margin-top:4px">
      <div class="line-head">
        <span>পণ্যের নাম</span><span>পরিমাণ</span><span>দাম</span><span>মোট</span><span></span>
      </div>
      <div id="pur-lines"></div>
      <button class="add-line-btn" onclick="addPurLine()">+ আরও পণ্য যোগ করুন</button>
    </div>

    <div class="grand-box">
      <span class="grand-lbl">মোট গ্র্যান্ড টোটাল</span>
      <span class="grand-val" id="p-grand">৳ ০</span>
    </div>
    <button class="btn bp" onclick="savePurBill()">✅ বিল সেভ করুন</button>
  </div>

  <div class="tc2">
    <div class="th2">
      <h3>ক্রয়ের তালিকা</h3>
      <input class="si" placeholder="🔍 খুঁজুন" oninput="renderPur(this.value)">
    </div>
    <div id="pur-list"></div>
    <div class="tr2"><span class="trl">মোট</span><span class="trv" id="pur-tot">৳ ০</span></div>
  </div>
</div>

<!-- ===== SALES ===== -->
<div class="pg" id="pg-sales">
  <div class="fc">
    <div class="ft">💰 বিক্রয় এন্ট্রি</div>
    <!-- হেডার — একবার -->
    <div class="fr">
      <div class="fg"><label>তারিখ *</label><input type="date" id="sd"></div>
      <div class="fg"><label>বিল নং</label><input type="text" id="sb" placeholder="নম্বর"></div>
    </div>
    <div class="ff fg">
      <label>Customer নাম *</label>
      <input type="text" id="sc" placeholder="Customer লিখুন..." autocomplete="off" oninput="showCusDrop(this.value)" onblur="hideDropAfter('cdrop')" onfocus="showCusDrop(this.value)">
      <div id="cdrop" style="display:none;position:relative;z-index:50;background:#fff;border:1.5px solid var(--g);border-radius:10px;max-height:180px;overflow-y:auto;margin-top:2px;box-shadow:0 4px 16px rgba(0,0,0,.1)"></div>
    </div>
    <div class="fr">
      <div class="fg"><label>পরিশোধ</label><input type="number" id="sp" placeholder="০" value="0" min="0"></div>
      <div class="fg"><label>মোবাইল/ব্যাংক</label>
        <select id="sbk"><option value="">নগদ</option><option>Bkash</option><option>Nagad</option><option>DBBL</option><option>ব্র্যাক ব্যাংক</option><option>IBBL</option></select>
      </div>
    </div>

    <!-- পণ্যের লাইন -->
    <div style="border-top:1px solid var(--bdr);padding-top:12px;margin-top:4px">
      <div class="line-head">
        <span>পণ্যের নাম</span><span>পরিমাণ</span><span>দাম</span><span>মোট</span><span></span>
      </div>
      <div id="sal-lines"></div>
      <button class="add-line-btn" onclick="addSalLine()">+ আরও পণ্য যোগ করুন</button>
    </div>

    <div class="grand-box sale">
      <span class="grand-lbl">মোট নিট বিক্রয়</span>
      <span class="grand-val" id="s-grand">৳ ০</span>
    </div>
    <button class="btn bg" onclick="saveSalBill()">✅ বিল সেভ করুন</button>
  </div>

  <div class="tc2">
    <div class="th2">
      <h3>বিক্রয়ের তালিকা</h3>
      <input class="si" placeholder="🔍 খুঁজুন" oninput="renderSal(this.value)">
    </div>
    <div id="sal-list"></div>
    <div class="tr2"><span class="trl">মোট</span><span class="trv" id="sal-tot">৳ ০</span></div>
  </div>
</div>

<!-- ===== EXPENSE ===== -->
<div class="pg" id="pg-expense">
  <div class="tabs">
    <button class="tab active" onclick="stab(this,'tx-d')">দৈনিক খরচ</button>
    <button class="tab" onclick="stab(this,'tx-m')">মাসিক খরচ</button>
  </div>
  <div class="tp active" id="tx-d">
    <div class="fc">
      <div class="ft">💸 দৈনিক খরচ</div>
      <div class="fr"><div class="fg"><label>তারিখ *</label><input type="date" id="ded"></div><div class="fg"><label>পরিমাণ *</label><input type="number" id="dea" placeholder="টাকা" min="0"></div></div>
      <div class="fr">
        <div class="fg"><label>ধরন *</label><select id="det"><option>চা/নাস্তা</option><option>যাতায়াত</option><option>প্যাকেজিং</option><option>রিকশা</option><option>লোডিং</option><option>বিবিধ</option><option>অন্যান্য</option></select></div>
        <div class="fg"><label>মাধ্যম</label><select id="des"><option>নগদ</option><option>Bkash</option><option>DBBL</option></select></div>
      </div>
      <div class="ff fg"><label>বিস্তারিত</label><input type="text" id="ded2" placeholder="বিস্তারিত"></div>
      <button class="btn bp" onclick="addDE()">✅ যোগ করুন</button>
    </div>
    <div class="tc2">
      <div class="th2"><h3>দৈনিক খরচ</h3></div>
      <div id="de-list"></div>
      <div class="tr2"><span class="trl">মোট</span><span class="trv" id="de-tot">৳ ০</span></div>
    </div>
  </div>
  <div class="tp" id="tx-m">
    <div class="fc">
      <div class="ft">🏢 মাসিক খরচ</div>
      <div class="fr">
        <div class="fg"><label>ধরন *</label><select id="met"><option>দোকান ভাড়া</option><option>গোডাউন ভাড়া</option><option>বেতন - বুলবুল</option><option>বেতন - অন্যান্য</option><option>বিদ্যুৎ (দোকান)</option><option>বিদ্যুৎ (গোডাউন)</option><option>সমিতি কিস্তি</option><option>ব্যাংক সুদ</option><option>অন্যান্য</option></select></div>
        <div class="fg"><label>পরিমাণ *</label><input type="number" id="mea" placeholder="টাকা" min="0"></div>
      </div>
      <div class="fr"><div class="fg"><label>মাস</label><input type="month" id="mem"></div><div class="fg"><label>মাধ্যম</label><select id="mes"><option>নগদ</option><option>Bkash</option><option>DBBL</option><option>ব্র্যাক ব্যাংক</option></select></div></div>
      <button class="btn bp" onclick="addME()">✅ যোগ করুন</button>
    </div>
    <div class="tc2">
      <div class="th2"><h3>মাসিক খরচ</h3></div>
      <div id="me-list"></div>
