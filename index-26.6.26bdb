// ===== UTILS =====
const fmt = n => '৳ ' + Math.round(n||0).toLocaleString('en-IN');
const fmtN = n => Math.round(n||0).toLocaleString('en-IN');
const today = () => new Date().toISOString().split('T')[0];
const $ = id => document.getElementById(id);
const v = id => $((id))?.value || '';
const nv = id => +($((id))?.value || 0);

function toast(msg, type='s') {
  const el = document.createElement('div');
  el.className = `tst ${type}`;
  el.innerHTML = `${type==='s'?'✅':'❌'} ${msg}`;
  $('tw').appendChild(el);
  setTimeout(() => el.remove(), 2500);
}

// ===== NAV =====
function goPage(id, navEl) {
  document.querySelectorAll('.pg').forEach(p => p.classList.remove('active'));
  $('pg-'+id)?.classList.add('active');
  if(navEl) {
    document.querySelectorAll('.nt').forEach(t => t.classList.remove('active'));
    navEl.classList.add('active');
  }
  renderAll();
  window.scrollTo(0,0);
}

function stab(btn, tabId) {
  btn.closest('.pg').querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
  btn.closest('.pg').querySelectorAll('.tp').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  $(tabId)?.classList.add('active');
}

// ===== DROPDOWN HELPERS =====
function makeDropItem(text, onclickFn) {
  const d = document.createElement('div');
  d.style.cssText = 'padding:10px 14px;cursor:pointer;font-size:13px;border-bottom:1px solid #f1f5f9;';
  d.textContent = text;
  d.onmousedown = (e) => { e.preventDefault(); onclickFn(text); };
  d.onmouseover = () => d.style.background = '#f1f5f9';
  d.onmouseout = () => d.style.background = '';
  return d;
}

function hideDropAfter(dropId) {
  setTimeout(() => { const d = $(dropId); if(d) d.style.display='none'; }, 200);
}

// Supplier dropdown
function showSupDrop(val) {
  const drop = $('sdrop');
  const list = [...new Set([...EXL.sup, ...DB.sud.map(s=>s.name)])].sort();
  const filtered = val ? list.filter(s => s.toLowerCase().includes(val.toLowerCase())) : list;
  drop.innerHTML = '';
  if(!filtered.length) { drop.style.display='none'; return; }
  filtered.slice(0,30).forEach(name => {
    drop.appendChild(makeDropItem(name, (n) => { $('ps').value=n; drop.style.display='none'; }));
  });
  drop.style.display = 'block';
}

// Customer dropdown
function showCusDrop(val) {
  const drop = $('cdrop');
  const list = [...new Set([...EXL.cus, ...DB.cud.map(c=>c.name)])].sort();
  const filtered = val ? list.filter(c => c.toLowerCase().includes(val.toLowerCase())) : list;
  drop.innerHTML = '';
  if(!filtered.length) { drop.style.display='none'; return; }
  filtered.slice(0,30).forEach(name => {
    drop.appendChild(makeDropItem(name, (n) => { $('sc').value=n; drop.style.display='none'; }));
  });
  drop.style.display = 'block';
}

// Stock dropdown (for stock page)
function showStkDrop(val) {
  const drop = $('stk-drop');
  const list = [...new Set([...EXL.stk.map(s=>s.name), ...DB.stk.map(s=>s.name)])].sort();
  const filtered = val ? list.filter(s => s.toLowerCase().includes(val.toLowerCase())) : list;
  drop.innerHTML = '';
  if(!filtered.length) { drop.style.display='none'; return; }
  filtered.slice(0,30).forEach(name => {
    const item = EXL.stk.find(s=>s.name===name) || DB.stk.find(s=>s.name===name);
    drop.appendChild(makeDropItem(`${name}${item?' (স্টক: '+item.qty+')':''}`, (n) => {
      $('stn').value = name;
      if(item) { $('stb').value=item.buyPrice; $('sts').value=item.sellPrice; }
      drop.style.display='none';
    }));
  });
  drop.style.display = 'block';
}

// Product dropdown for a line (ক্রয় বা বিক্রয়)
function showProdDrop(inputEl, dropEl, type) {
  const val = inputEl.value;
  const allStk = [...EXL.stk, ...DB.stk.filter(s => !EXL.stk.find(e=>e.name===s.name))];
  const filtered = val ? allStk.filter(s => s.name.toLowerCase().includes(val.toLowerCase())) : allStk;
  dropEl.innerHTML = '';
  if(!filtered.length) { dropEl.style.display='none'; return; }
  filtered.slice(0,30).forEach(item => {
    const price = type==='buy' ? item.buyPrice : item.sellPrice;
    dropEl.appendChild(makeDropItem(`${item.name} — ৳${price}`, () => {
      inputEl.value = item.name;
      dropEl.style.display = 'none';
      // দাম অটো সেট
      const lineDiv = inputEl.closest('.pline');
      if(lineDiv) {
        const priceInput = lineDiv.querySelector('.price-inp');
        if(priceInput && !priceInput.value) {
          priceInput.value = price;
          calcLine(lineDiv);
        }
      }
    }));
  });
  dropEl.style.display = 'block';
}

// ===== MULTI-LINE PURCHASE =====
let purLineId = 0;
function addPurLine() {
  purLineId++;
  const id = purLineId;
  const wrap = document.createElement('div');
  wrap.style.cssText = 'position:relative;margin-bottom:10px';

  const row = document.createElement('div');
  row.className = 'pline';
  row.innerHTML = `
    <input type="text" placeholder="পণ্যের নাম *" class="prod-inp" autocomplete="off"
      style="padding:9px 10px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:13px;width:100%">
    <input type="number" placeholder="পরিমাণ" class="qty-inp" min="0"
      style="padding:9px 10px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:13px;width:100%">
    <input type="number" placeholder="দাম" class="price-inp" min="0"
      style="padding:9px 10px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:13px;width:100%">
    <input type="number" placeholder="মোট" class="total-inp" readonly
      style="padding:9px 10px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:13px;width:100%;background:#f8fafc;font-weight:700">
    <button onclick="this.closest('[style]').remove();calcAllPur()" style="width:36px;height:38px;border:none;border-radius:10px;background:var(--rb);color:var(--r);font-size:16px;cursor:pointer">✕</button>
  `;

  // Product dropdown
  const prodDrop = document.createElement('div');
  prodDrop.style.cssText = 'display:none;position:absolute;left:0;right:0;top:44px;z-index:100;background:#fff;border:1.5px solid var(--pl);border-radius:10px;max-height:200px;overflow-y:auto;box-shadow:0 4px 16px rgba(0,0,0,.12)';

  wrap.appendChild(row);
  wrap.appendChild(prodDrop);
  $('pur-lines').appendChild(wrap);

  const prodInp = row.querySelector('.prod-inp');
  const qtyInp = row.querySelector('.qty-inp');
  const priceInp = row.querySelector('.price-inp');

  prodInp.addEventListener('input', () => showProdDrop(prodInp, prodDrop, 'buy'));
  prodInp.addEventListener('focus', () => showProdDrop(prodInp, prodDrop, 'buy'));
  prodInp.addEventListener('blur', () => setTimeout(() => prodDrop.style.display='none', 200));

  // Enter চাপলে পরিমাণ বক্সে যাবে অথবা নতুন লাইন
  prodInp.addEventListener('keydown', e => {
    if(e.key==='Enter') { e.preventDefault(); qtyInp.focus(); }
  });
  qtyInp.addEventListener('keydown', e => {
    if(e.key==='Enter') { e.preventDefault(); priceInp.focus(); }
  });
  priceInp.addEventListener('keydown', e => {
    if(e.key==='Enter') { e.preventDefault(); addPurLine(); }
  });

  row.querySelector('.qty-inp').addEventListener('input', () => calcLine(row));
  row.querySelector('.price-inp').addEventListener('input', () => calcLine(row));

  setTimeout(() => prodInp.focus(), 80);
}

function calcLine(row) {
  const q = +row.querySelector('.qty-inp').value || 0;
  const p = +row.querySelector('.price-inp').value || 0;
  row.querySelector('.total-inp').value = q*p || '';
  calcAllPur();
}

function calcAllPur() {
  let total = 0;
  $('pur-lines').querySelectorAll('.total-inp').forEach(inp => total += +inp.value || 0);
  $('p-grand').textContent = fmt(total);
}

function savePurBill() {
  const date = v('pd'), sup = v('ps').trim();
  if(!date||!sup) return toast('তারিখ ও Supplier নাম দিন','e');
  const paid = nv('pp');
  const lines = [];
  $('pur-lines').querySelectorAll('.pline').forEach(row => {
    const prod = row.querySelector('.prod-inp').value.trim();
    const qty = +row.querySelector('.qty-inp').value || 0;
    const price = +row.querySelector('.price-inp').value || 0;
    if(prod && qty>0 && price>0) lines.push({prod, qty, price, grand: qty*price});
  });
  if(!lines.length) return toast('অন্তত একটি পণ্য দিন','e');
  const total = lines.reduce((s,l)=>s+l.grand,0);
  const due = total - paid;
  const bid = Date.now();
  lines.forEach((l,i) => {
    DB.pur.push({id:bid+i, date, memo:v('pm'), supplier:sup, product:l.prod, qty:l.qty, price:l.price, grand:l.grand, paid:i===0?paid:0, due:i===0?due:0, note:v('pnt')});
  });
  save(); renderAll();
  $('pm').value=''; $('ps').value=''; $('pp').value=0; $('pnt').value='';
  $('pur-lines').innerHTML=''; purLineId=0;
  $('p-grand').textContent='৳ ০';
  addPurLine();
  toast(`${lines.length}টি পণ্য সেভ হয়েছে!`);
}

function renderPur(q='') {
  const rows = DB.pur.filter(r=>!q||r.supplier.toLowerCase().includes(q.toLowerCase())||r.product.toLowerCase().includes(q.toLowerCase()));
  const el = $('pur-list'); if(!el) return;
  el.innerHTML = rows.length ? [...rows].reverse().map(r=>`
    <div class="li">
      <div class="lic" style="background:#dbeafe">🛒</div>
      <div class="lib">
        <div class="lit">${r.product}</div>
        <div class="lis">${r.supplier} | ${r.qty}টি × ${fmtN(r.price)}</div>
        <div class="lis">${r.date}${r.memo?' | মেমো: '+r.memo:''}</div>
      </div>
      <div class="lir">
        <div class="lia">${fmt(r.grand)}</div>
        <span class="bd ${r.due>0?'bdr2':'bdg'}">${r.due>0?'বাকি: '+fmtN(r.due):'পরিশোধ'}</span>
      </div>
      <button class="db" onclick="DB.pur=DB.pur.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`).join('')
    : '<div class="empty"><div class="ei">🛒</div><p>কোনো ক্রয় নেই</p></div>';
  const tot = rows.reduce((s,r)=>s+r.grand,0);
  const el2=$('pur-tot'); if(el2) el2.textContent=fmt(tot);
}

// ===== MULTI-LINE SALES =====
let salLineId = 0;
function addSalLine() {
  salLineId++;
  const wrap = document.createElement('div');
  wrap.style.cssText = 'position:relative;margin-bottom:10px';

  const row = document.createElement('div');
  row.className = 'pline';
  row.innerHTML = `
    <input type="text" placeholder="পণ্যের নাম *" class="prod-inp" autocomplete="off"
      style="padding:9px 10px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:13px;width:100%">
    <input type="number" placeholder="পরিমাণ" class="qty-inp" min="0"
      style="padding:9px 10px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:13px;width:100%">
    <input type="number" placeholder="দাম" class="price-inp" min="0"
      style="padding:9px 10px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:13px;width:100%">
    <input type="number" placeholder="মোট" class="total-inp" readonly
      style="padding:9px 10px;border:1.5px solid var(--bdr);border-radius:10px;font-family:inherit;font-size:13px;width:100%;background:#f8fafc;font-weight:700">
    <button onclick="this.closest('[style]').remove();calcAllSal()" style="width:36px;height:38px;border:none;border-radius:10px;background:var(--rb);color:var(--r);font-size:16px;cursor:pointer">✕</button>
  `;

  const prodDrop = document.createElement('div');
  prodDrop.style.cssText = 'display:none;position:absolute;left:0;right:0;top:44px;z-index:100;background:#fff;border:1.5px solid var(--g);border-radius:10px;max-height:200px;overflow-y:auto;box-shadow:0 4px 16px rgba(0,0,0,.12)';

  wrap.appendChild(row);
  wrap.appendChild(prodDrop);
  $('sal-lines').appendChild(wrap);

  const prodInp = row.querySelector('.prod-inp');
  const qtyInp = row.querySelector('.qty-inp');
  const priceInp = row.querySelector('.price-inp');

  prodInp.addEventListener('input', () => showProdDrop(prodInp, prodDrop, 'sell'));
  prodInp.addEventListener('focus', () => showProdDrop(prodInp, prodDrop, 'sell'));
  prodInp.addEventListener('blur', () => setTimeout(() => prodDrop.style.display='none', 200));

  prodInp.addEventListener('keydown', e => { if(e.key==='Enter'){e.preventDefault();qtyInp.focus();} });
  qtyInp.addEventListener('keydown', e => { if(e.key==='Enter'){e.preventDefault();priceInp.focus();} });
  priceInp.addEventListener('keydown', e => { if(e.key==='Enter'){e.preventDefault();addSalLine();} });

  row.querySelector('.qty-inp').addEventListener('input', () => calcSalLine(row));
  row.querySelector('.price-inp').addEventListener('input', () => calcSalLine(row));

  setTimeout(() => prodInp.focus(), 80);
}

function calcSalLine(row) {
  const q = +row.querySelector('.qty-inp').value || 0;
  const p = +row.querySelector('.price-inp').value || 0;
  row.querySelector('.total-inp').value = q*p || '';
  calcAllSal();
}

function calcAllSal() {
  let total = 0;
  $('sal-lines').querySelectorAll('.total-inp').forEach(inp => total += +inp.value || 0);
  $('s-grand').textContent = fmt(total);
}

function saveSalBill() {
  const date = v('sd'), cus = v('sc').trim();
  if(!date||!cus) return toast('তারিখ ও Customer নাম দিন','e');
  const paid = nv('sp');
  const lines = [];
  $('sal-lines').querySelectorAll('.pline').forEach(row => {
    const prod = row.querySelector('.prod-inp').value.trim();
    const qty = +row.querySelector('.qty-inp').value || 0;
    const price = +row.querySelector('.price-inp').value || 0;
    if(prod && qty>0 && price>0) lines.push({prod, qty, price, net: qty*price});
  });
  if(!lines.length) return toast('অন্তত একটি পণ্য দিন','e');
  const total = lines.reduce((s,l)=>s+l.net,0);
  const due = total - paid;
  const bid = Date.now();
  lines.forEach((l,i) => {
    DB.sal.push({id:bid+i, date, bill:v('sb'), customer:cus, product:l.prod, qty:l.qty, price:l.price, net:l.net, paid:i===0?paid:0, due:i===0?due:0, bank:v('sbk')});
  });
  save(); renderAll();
  $('sb').value=''; $('sc').value=''; $('sp').value=0;
  $('sal-lines').innerHTML=''; salLineId=0;
  $('s-grand').textContent='৳ ০';
  addSalLine();
  toast(`${lines.length}টি পণ্য সেভ হয়েছে!`);
}

function renderSal(q='') {
  const rows = DB.sal.filter(r=>!q||r.customer.toLowerCase().includes(q.toLowerCase())||r.product.toLowerCase().includes(q.toLowerCase()));
  const el=$('sal-list'); if(!el) return;
  el.innerHTML = rows.length ? [...rows].reverse().map(r=>`
    <div class="li">
      <div class="lic" style="background:var(--gb)">💰</div>
      <div class="lib">
        <div class="lit">${r.product}</div>
        <div class="lis">${r.customer} | ${r.qty}টি × ${fmtN(r.price)}</div>
        <div class="lis">${r.date}${r.bank?' | '+r.bank:''}</div>
      </div>
      <div class="lir">
        <div class="lia profit">${fmt(r.net)}</div>
        <span class="bd ${r.due>0?'bdr2':'bdg'}">${r.due>0?'বাকি: '+fmtN(r.due):'পরিশোধ'}</span>
      </div>
      <button class="db" onclick="DB.sal=DB.sal.filter(x=>x.id!==${r.id});save();renderAll()">🗑️</button>
    </div>`).join('')
    : '<div class="empty"><div class="ei">💰</div><p>কোনো বিক্রয় নেই</p></div>';
  const tot=rows.reduce((s,r)=>s+r.net,0);
  const el2=$('sal-tot'); if(el2) el2.textContent=fmt(tot);
}

// ===== EXPENSE =====
function addDE() {
  const date=v('ded'), amt=nv('dea');
  if(!date||!amt) return toast('তারিখ ও পরিমাণ দিন','e');
  DB.de.push({id:Date.now(),date,type:v('det'),detail:v('ded2'),source:v('des'),amt});
  save();renderAll();
  $('dea').value='';$('ded2').value='';
  toast('খরচ যোগ হয়েছে!');
}
